content_margin_top = 2.0
content_margin_right = 6.0
content_margin_bottom = 3.0
bg_color = Color(0.08, 0.05, 0.05, 0.8)

[node name="Hud" type="CanvasLayer"]
layer = 5
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
