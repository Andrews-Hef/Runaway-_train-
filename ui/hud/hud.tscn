[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud/hud.gd" id="1_hud"]
[ext_resource type="Theme" path="res://ui/theme/game_theme.tres" id="9_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 4.0
content_margin_top = 3.0
content_margin_right = 4.0
content_margin_bottom = 3.0
bg_color = Color(0.05, 0.05, 0.07, 0.65)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_bg"]
bg_color = Color(0, 0, 0, 0.6)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_fill"]
bg_color = Color(0.7529412, 0.41960785, 1, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_banner"]
content_margin_left = 6.0
content_margin_top = 2.0
content_margin_right = 6.0
content_margin_bottom = 3.0
bg_color = Color(0.08, 0.05, 0.05, 0.8)

[node name="Hud" type="CanvasLayer"]
layer = 5
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
theme = ExtResource("9_theme")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Status" type="PanelContainer" parent="Root"]
layout_mode = 0
offset_left = 4.0
offset_top = 4.0
offset_right = 84.0
offset_bottom = 40.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="Root/Status"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="TimerLabel" type="Label" parent="Root/Status/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Départ 1:30"

[node name="ExposureLabel" type="Label" parent="Root/Status/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Exposition 0 %"

[node name="ExposureBar" type="ProgressBar" parent="Root/Status/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(72, 4)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_bar_fill")
max_value = 1.0
step = 0.001
show_percentage = false

[node name="ZoneWarning" type="Label" parent="Root/Status/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.7529412, 0.41960785, 1, 1)
text = "Zone infectée !"

[node name="Loot" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -4.0
offset_top = 4.0
offset_right = -4.0
offset_bottom = 4.0
grow_horizontal = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="LootList" type="VBoxContainer" parent="Root/Loot"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 1

[node name="Banner" type="Label" parent="Root"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -130.0
offset_top = 62.0
offset_right = 130.0
offset_bottom = 80.0
grow_horizontal = 2
theme_override_styles/normal = SubResource("StyleBoxFlat_banner")
theme_override_colors/font_color = Color(1, 0.82, 0.35, 1)
theme_override_colors/font_outline_color = Color(0.08, 0.06, 0.06, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
text = "Le train siffle ! Remonte à bord !"
horizontal_alignment = 1

[node name="Prompt" type="Label" parent="Root"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -120.0
offset_top = -26.0
offset_right = 120.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_outline_color = Color(0.08, 0.06, 0.06, 1)
theme_override_constants/outline_size = 4
text = "Maintenir E : Fouiller l'épave"
horizontal_alignment = 1
