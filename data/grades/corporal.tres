[gd_resource type="Resource" script_class="GradeData" format=3]

[ext_resource type="Script" path="res://core/perk_data.gd" id="1_perk"]
[ext_resource type="Script" path="res://core/grade_data.gd" id="2_grade"]

[sub_resource type="Resource" id="Resource_p0"]
script = ExtResource("1_perk")
id = &"brawler"
display_name = "Bagarreur"
description = "Tes coups portent plus."
damage = 1

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_perk")
id = &"slippery"
display_name = "Insaisissable"
description = "Les rampants ne te tiennent pas longtemps."
mash_power = 1.0

[resource]
script = ExtResource("2_grade")
id = &"corporal"
display_name = "Caporal"
description = "On te confie les sorties difficiles."
merit_needed = 70
perks = Array[ExtResource("1_perk")]([SubResource("Resource_p0"), SubResource("Resource_p1")])
