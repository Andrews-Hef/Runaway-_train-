[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://core/encounter_choice.gd" id="1_fadp2"]
[ext_resource type="Script" path="res://core/encounter_data.gd" id="2_iaxfs"]

[sub_resource type="Resource" id="Resource_8piq5"]
script = ExtResource("1_fadp2")
label = "Fouiller le sac"
random_reward_pool = Array[StringName]([&"scrap", &"wood", &"herb"])
random_reward_amount = Vector2i(2, 4)
exposure = 0.12
outcome_text = "Tu vides le sac en retenant ton souffle."

[sub_resource type="Resource" id="Resource_63ym7"]
script = ExtResource("1_fadp2")
label = "Laisser le sac"
leave = true
outcome_text = "Mieux vaut ne pas s'approcher."

[resource]
script = ExtResource("2_iaxfs")
id = &"abandoned_backpack"
title = "Un sac abandonné"
text = "Un sac à dos traîne près d'une silhouette immobile, couverte de filaments violets. Il y a peut-être quelque chose dedans."
choices = Array[ExtResource("1_fadp2")]([SubResource("Resource_8piq5"), SubResource("Resource_63ym7")])
prompt = "Examiner"
