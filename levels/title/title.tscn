[gd_scene format=3]

[ext_resource type="Script" path="res://levels/title/title.gd" id="1_title"]
[ext_resource type="TileSet" path="res://assets/tiles/ground_tileset.tres" id="2_tileset"]
[ext_resource type="PackedScene" path="res://entities/train/train.tscn" id="3_train"]
[ext_resource type="Theme" path="res://ui/theme/game_theme.tres" id="4_theme"]

[node name="Title" type="Node2D"]
script = ExtResource("1_title")

[node name="Ground" type="Parallax2D" parent="."]
repeat_size = Vector2(768, 0)
autoscroll = Vector2(-80, 0)
repeat_times = 3

[node name="Tiles" type="TileMapLayer" parent="Ground"]
position = Vector2(0, 62)
tile_set = ExtResource("2_tileset")

[node name="Train" parent="." instance=ExtResource("3_train")]
position = Vector2(-184, 70)
start_running = true

[node name="Camera2D" type="Camera2D" parent="."]

[node name="Ui" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="Ui"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_theme")

[node name="Panel" type="PanelContainer" parent="Ui/Root"]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -150.0
offset_top = 14.0
offset_right = 150.0
offset_bottom = 120.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Ui/Root/Panel"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Name" type="Label" parent="Ui/Root/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.35, 1)
theme_override_font_sizes/font_size = 16
text = "Runaway Train"
horizontal_alignment = 1

[node name="Continue" type="Button" parent="Ui/Root/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
text = "Continuer"

[node name="NewGame" type="Button" parent="Ui/Root/Panel/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
text = "Nouvelle partie"

[node name="Hint" type="Label" parent="Ui/Root/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.78, 0.82, 1)
text = "Tu viens d'être recruté à bord."
horizontal_alignment = 1
autowrap_mode = 3
